    "e2e:smoke": "npm --prefix tests/e2e run e2e:smoke"
  },
  "devDependencies": {
    "@synopackageland/cli": "0.41.9",
    "@synopackageland/templates": "0.35.5",
    "yaml": "2.9.1"
  }
}
